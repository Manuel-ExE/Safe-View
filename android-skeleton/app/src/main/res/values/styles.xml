<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Small uppercase eyebrow label used to group rows within a settings card. -->
    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/sv_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- 1dp hairline separating rows inside a card. -->
    <style name="RowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginVertical">12dp</item>
        <item name="android:background">@drawable/bg_section_divider</item>
    </style>

    <!-- One-line helper text under a switch, explaining what it does. -->
    <style name="RowCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/sv_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <!-- Live status line under a switch (e.g. "On — filter active"). -->
    <style name="RowStatus">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/sv_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

</resources>
