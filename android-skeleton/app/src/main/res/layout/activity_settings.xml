<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sv_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:background="@color/sv_toolbar"
            android:elevation="3dp">

            <ImageButton
                android:id="@+id/btnBackSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings"
                android:textColor="@color/sv_text"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your protection"
                android:textColor="@color/sv_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Choose how SafeView protects your browsing and visible apps. Tap the status card to complete setup."
                android:textColor="@color/sv_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- Protection card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/sv_card"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/sv_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Protection status"
                    android:textColor="@color/sv_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/setupStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="Setup status"
                    android:textColor="@color/sv_muted"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <!-- Browsing -->
                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="16dp"
                    android:text="BROWSING" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/protection_enabled"
                    android:textColor="@color/sv_text" />

                <View style="@style/RowDivider" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchStrict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/strict_mode"
                    android:textColor="@color/sv_text" />

                <TextView
                    style="@style/RowCaption"
                    android:text="Blocks explicit search terms and unclear media instead of allowing it through." />

                <View style="@style/RowDivider" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchReveal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/click_to_reveal"
                    android:textColor="@color/sv_text" />

                <TextView
                    style="@style/RowCaption"
                    android:text="Blocked images stay hidden until tapped, instead of being removed outright." />

                <!-- Background VPN -->
                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="18dp"
                    android:text="BACKGROUND PROTECTION" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/background_protection"
                    android:textColor="@color/sv_text" />

                <TextView
                    android:id="@+id/backgroundStatus"
                    style="@style/RowStatus"
                    android:text="@string/background_status_off" />

                <!-- Screen AI -->
                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="18dp"
                    android:text="SCREEN AI" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchScreenAi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/screen_ai_protection"
                    android:textColor="@color/sv_text" />

                <TextView
                    android:id="@+id/screenAiStatus"
                    style="@style/RowStatus"
                    android:text="@string/screen_ai_status_off" />

                <View style="@style/RowDivider" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchScreenAiWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_ai_warning_mode"
                    android:textColor="@color/sv_text" />

                <TextView
                    style="@style/RowCaption"
                    android:text="@string/screen_ai_warning_summary" />

                <View style="@style/RowDivider" />

                <TextView
                    android:id="@+id/appRulesButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="12dp"
                    android:text="@string/app_rules_button"
                    android:textColor="@color/sv_text"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/appRulesSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_rules_none"
                    android:textColor="@color/sv_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AI card -->
        <TextView
            style="@style/SectionLabel"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="6dp"
            android:text="AI CLASSIFIER" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/sv_card"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/sv_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/aiStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_status_missing"
                    android:textColor="@color/sv_muted"
                    android:textSize="12sp"
                    android:paddingBottom="10dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_classifier"
                    android:textColor="@color/sv_text" />

                <View style="@style/RowDivider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Explicit threshold"
                    android:textColor="@color/sv_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderExplicit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.10"
                    android:valueTo="0.90"
                    android:stepSize="0.05"
                    android:value="0.40"
                    app:labelBehavior="withinBounds" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Revealing threshold"
                    android:textColor="@color/sv_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderRevealing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.05"
                    android:valueTo="0.50"
                    android:stepSize="0.01"
                    android:value="0.12"
                    app:labelBehavior="withinBounds" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Display card -->
        <TextView
            style="@style/SectionLabel"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="6dp"
            android:text="@string/display_mode" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/sv_card"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/sv_line"
            app:strokeWidth="1dp">

            <RadioGroup
                android:id="@+id/radioDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp">

                <RadioButton
                    android:id="@+id/radioBlur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="@string/display_blur"
                    android:textColor="@color/sv_text"
                    android:checked="true" />

                <View style="@style/RowDivider" />

                <RadioButton
                    android:id="@+id/radioPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="@string/display_placeholder"
                    android:textColor="@color/sv_text" />
            </RadioGroup>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="28dp"
            android:text="@string/privacy_note"
            android:textColor="@color/sv_muted"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
